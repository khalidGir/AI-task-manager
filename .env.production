# Production Environment Variables

# Database configuration
DB_PASSWORD=very-secure-db-password-change-me

# JWT configuration
JWT_SECRET=very-long-and-secure-jwt-secret-key-change-in-production

# API Configuration
API_URL=http://localhost:3001/api/v1

# Backend configuration
PORT=3001
NODE_ENV=production

# Frontend configuration (for Vite build)
VITE_API_URL=http://localhost:3001/api/v1

# Optional: External service configurations (AI, etc.)
OPENAI_API_KEY=your-openai-api-key-if-using

# Security
CORS_ORIGIN=http://localhost:3000,http://localhost:80 # Adjust for your domain